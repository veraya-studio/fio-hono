{
  "name": "pio-bun-minimal-boilerplate",
  "version": "0.1.0",
  "description": "Minimal Bun server boilerplate with TypeScript, winston, envalid, ofetch, and antfu's ESLint config. Includes an optional CLI powered by cac. Tests run on vitest.",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "pio": "src/cli/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "cli": "bun run src/cli/index.ts",
    "build": "bun build src/server.ts --outdir dist --target=bun --minify",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "envalid": "^8.1.1",
    "ofetch": "^1.5.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/bun": "latest",
    "eslint": "^10.4.1",
    "eslint-compat-utils": "^0.6.5",
    "eslint-plugin-format": "^2.0.1",
    "typescript-eslint": "^8.60.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
