{
  "name": "fio-hono-cf",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Modular Hono boilerplate for Cloudflare Workers with D1, Prisma, JWT auth, OpenAPI, and Scalar.",
  "license": "MIT",
  "module": "src/index.ts",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run generate && wrangler dev",
    "deploy": "bun run generate && wrangler deploy",
    "build": "bun run generate && wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env-file .dev.vars.example --strict-vars=false",
    "db:generate": "bunx --bun prisma generate",
    "generate": "bun run cf-typegen && bun run db:generate",
    "generate:module": "plop module",
    "db:migration:create": "bun run scripts/create-migration.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "bun run generate",
    "typecheck": "bun run generate && tsc --noEmit",
    "test": "bun test tests",
    "test:worker": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "@prisma/adapter-d1": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/hono-api-reference": "^0.11.14",
    "hono": "^4.13.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "eslint": "^10.4.1",
    "eslint-compat-utils": "^0.6.5",
    "eslint-plugin-format": "^2.0.1",
    "plop": "^4.0.5",
    "prisma": "^7.9.1",
    "typescript": "^5",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.45.0"
  }
}
