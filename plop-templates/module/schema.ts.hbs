import { z } from '@hono/zod-openapi'
import { successSchema } from '../../lib/http'

export const {{pascalCase name}}StatusSchema = z.object({
  module: z.literal('{{dashCase name}}'),
  status: z.literal('ready'),
}).openapi('{{pascalCase name}}Status')

export const {{pascalCase name}}StatusResponseSchema = successSchema({{pascalCase name}}StatusSchema)
  .openapi('{{pascalCase name}}StatusResponse')

export type {{pascalCase name}}Status = z.infer<typeof {{pascalCase name}}StatusSchema>
